local function track(c)
	table.insert(connections, c)
	return c
end

local function resolveParent()
	if gethui then
		local ok, h = pcall(gethui)
		if ok and h then return h end
	end
	local ok, cg = pcall(function() return cloneref(game:GetService("CoreGui")) end)
	if ok and cg then return cg end
	return lp:WaitForChild("PlayerGui")
end
local guiParent = resolveParent()

local function getRoot()
	local ch = lp.Character
	return ch and ch:FindFirstChild("HumanoidRootPart")
end

local function getHum()
	local ch = lp.Character
	return ch and ch:FindFirstChildOfClass("Humanoid")
end

local function posOf(inst: Instance): Vector3?
	if inst:IsA("BasePart") then return inst.Position end
	if inst:IsA("Model") then
		local ok, cf = pcall(inst.GetPivot, inst)
		if ok then return cf.Position end
	end
	return nil
end

local function adorneePart(inst: Instance)
	if inst:IsA("BasePart") then return inst end
	if inst:IsA("Model") then
		return inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart", true)
	end
	return nil
end

-- egg detection
local function isEgg(inst: Instance): boolean
	if not (inst:IsA("BasePart") or inst:IsA("Model")) then return false end
	if not inst.Name:lower():find("egg") then return false end
	local ch = lp.Character
	if ch and inst:IsDescendantOf(ch) then return false end
	if inst:IsA("BasePart") and inst.Parent and inst.Parent:IsA("Model")
		and inst.Parent.Name:lower():find("egg") then
		return false
	end
	return true
end

local function consider(inst: Instance)
	if isEgg(inst) then eggs[inst] = true end
end

for _, d in ipairs(Workspace:GetDescendants()) do consider(d) end
track(Workspace.DescendantAdded:Connect(consider))

task.spawn(function()
	while alive do
		task.wait(1)
		for inst in pairs(eggs) do
			if not inst.Parent then eggs[inst] = nil end
		end
	end
end)

-- pet reading (used to rank eggs)
local KEYS = { "pet", "reward", "content", "hatch", "result", "item", "unit", "brainrot" }

local function hasKey(name: string): boolean
	local n = name:lower()
	for _, k in ipairs(KEYS) do
		if n:find(k) then return true end
	end
	return false
end

local function readFrom(inst: Instance): string?
	for k, v in pairs(inst:GetAttributes()) do
		if type(v) == "string" and v ~= "" and hasKey(k) then
			return v
		end
	end
	for _, d in ipairs(inst:GetDescendants()) do
		if d:IsA("StringValue") and d.Value ~= "" and hasKey(d.Name) then
			return d.Value
		end
		if d:IsA("ObjectValue") and d.Value and hasKey(d.Name) then
			return d.Value.Name
		end
		if (d:IsA("Model") or d:IsA("BasePart")) and d.Name:lower():find("pet") then
			return d.Name
		end
		for k, v in pairs(d:GetAttributes()) do
			if type(v) == "string" and v ~= "" and hasKey(k) then
				return v
			end
		end
	end
	return nil
end

local function readPet(inst: Instance): string?
	local found = readFrom(inst)
	if found then return found end
	local par = inst.Parent
	if par and par ~= Workspace and par:IsA("Model") then
		for k, v in pairs(par:GetAttributes()) do
			if type(v) == "string" and v ~= "" and hasKey(k) then
				return v
			end
		end
	end
	return nil
end

-- best egg scoring
local RANKS = {
	{ "secret", 8 }, { "divine", 8 }, { "mythic", 7 }, { "legend", 6 },
	{ "epic", 5 }, { "rare", 4 }, { "uncommon", 3 }, { "common", 2 },
}
local NUM_KEYS = { "rarity", "tier", "value", "price", "cost", "worth", "multiplier", "level", "luck" }

local function rankOf(text: string): number
	local t = text:lower()
	for _, r in ipairs(RANKS) do
		if t:find(r[1]) then return r[2] end
	end
	return 0
end

local function scoreEgg(inst: Instance): number
	local rankBest, numBest = rankOf(inst.Name), 0
	local pet = readPet(inst)
	if pet then rankBest = math.max(rankBest, rankOf(pet)) end

	local function scan(o: Instance)
		for k, v in pairs(o:GetAttributes()) do
			local kl = tostring(k):lower()
			if type(v) == "string" then
				rankBest = math.max(rankBest, rankOf(v))
			elseif type(v) == "number" then
				for _, nk in ipairs(NUM_KEYS) do
					if kl:find(nk) then
						numBest = math.max(numBest, v)
						break
					end
				end
			end
		end
	end

	scan(inst)
	for _, d in ipairs(inst:GetDescendants()) do scan(d) end
	return rankBest * 1e6 + math.min(numBest, 999999)
end

local function bestEgg(from: Vector3): Instance?
	local best, bestScore, bestDist = nil, -1, math.huge
	for inst in pairs(eggs) do
		if inst.Parent then
			local p = posOf(inst)
			if p then
				local s = scoreEgg(inst)
				local d = (p - from).Magnitude
				if s > bestScore or (s == bestScore and d < bestDist) then
					best, bestScore, bestDist = inst, s, d
				end
			end
		end
	end
	return best
end

