local function setStatus(t: string)
	statusLabel.Text = t
end

local function safeSpot(): Vector3?
	local s = env.MilkEggSaved
	if typeof(s) == "Vector3" then return s end
	return nil
end

track(saveBtn.MouseButton1Click:Connect(function()
	if mode == "going" or mode == "returning" then return end
	local root = getRoot()
	if not root then return end
	env.MilkEggSaved = root.Position
	mode = "idle"
	setStatus("zona segura salva")
end))

track(huntBtn.MouseButton1Click:Connect(function()
	if mode ~= "idle" then
		setStatus(mode == "returning" and "voltando. aguarde" or "volte pra zona segura")
		return
	end
	local home = safeSpot()
	if not home then setStatus("salve a zona segura") return end
	local root = getRoot()
	if not root then return end
	if (root.Position - home).Magnitude > SAFE_RADIUS then
		setStatus("so na zona segura")
		return
	end
	local egg = bestEgg(root.Position)
	if not egg then setStatus("nenhum ovo achado") return end

	token += 1
	local my = token
	mode = "going"
	setStatus("indo: " .. egg.Name)

	task.spawn(function()
		local ok = glide(function()
			if not egg.Parent then return nil end
			local p = posOf(egg)
			return p and (p + Vector3.new(0, 3, 0)) or nil
		end, my)
		if token ~= my then return end
		if ok then
			setStatus("coletando")
			pcall(collectEgg, egg)
			if token ~= my then return end
			mode = "atEgg"
			setStatus("no ovo. aperte voltar")
		else
			mode = "away"
			setStatus("ovo sumiu. aperte voltar")
		end
	end)
end))

track(homeBtn.MouseButton1Click:Connect(function()
	if mode == "returning" then return end
	local home = safeSpot()
	if not home then setStatus("salve a zona segura") return end

	token += 1
	local my = token
	mode = "returning"
	setStatus("voltando")

	task.spawn(function()
		local ok = glide(function() return home end, my)
		if token ~= my then return end
		mode = ok and "idle" or "away"
		setStatus(ok and "na zona segura" or "falhou. tente de novo")
	end)
end))

-- minimize / close
local minimized = false
track(minBtn.MouseButton1Click:Connect(function()
	minimized = not minimized
	body.Visible = not minimized
	minBtn.Text = minimized and "+" or "-"
	main.Size = UDim2.fromOffset(220, minimized and BAR_H or (BAR_H + BODY_H))
end))

local function cleanup()
	alive = false
	token += 1
	for _, c in ipairs(connections) do
		pcall(function() c:Disconnect() end)
	end
	connections = {}
	pcall(function() gui:Destroy() end)
end
env.MilkEggCleanup = cleanup

track(closeBtn.MouseButton1Click:Connect(cleanup))

track(UIS.InputBegan:Connect(function(i, gp)
	if gp then return end
	if i.KeyCode == Enum.KeyCode.RightShift then
		main.Visible = not main.Visible
	end
end))
